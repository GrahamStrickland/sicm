{:paths ["src" "dev" "notebooks"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        io.github.nextjournal/clerk {:git/sha "a46ea503eb71a63c85006807928a9eea52d7d07a"}
        org.babashka/sci {:mvn/version "0.11.50"}
        org.mentat/emmy {:mvn/version "0.32.0"
                         ;; This is required because Clerk specifies SCI using a
                         ;; git dependency and `clojure` can't resolve the
                         ;; conflict.
                         :exclusions [org.babashka/sci]}
        io.github.mentat-collective/clerk-utils {:git/sha "a508ab01d0fb04a44c0a6a1dd510207b2ca7135e"}}
 :aliases
 {:nextjournal/clerk
  {:extra-deps
   {io.github.nextjournal/clerk.render
    {:git/url "https://github.com/nextjournal/clerk"
     ;; make sure this sha matches the one in `:deps` above.
     :git/sha "a46ea503eb71a63c85006807928a9eea52d7d07a"
     :deps/root "render"}
    ;; Explicit SLF4J binding so Clerk's file watcher stops printing the
    ;; "Failed to load StaticLoggerBinder / defaulting to NOP" notice.
    org.slf4j/slf4j-nop {:mvn/version "1.7.36"}}
   ;; Grant JNA (used by the directory watcher for macOS FSEvents) native
   ;; access so the JDK doesn't warn about restricted methods.
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :exec-fn user/build!}

  ;; nREPL server for editor integration (Conjure, CIDER, etc.). Combine with
  ;; `:nextjournal/clerk` so the REPL also has Clerk's render deps on the
  ;; classpath, e.g. `clojure -M:nextjournal/clerk:nrepl`.
  :nrepl
  {:extra-deps
   {nrepl/nrepl {:mvn/version "1.3.0"}
    cider/cider-nrepl {:mvn/version "0.50.2"}}
   :main-opts ["-m" "nrepl.cmdline"
               "--middleware" "[cider.nrepl/cider-middleware]"]}}}
